# ============================================================
# Zeus AI — Variáveis de ambiente (copie para .env e preencha)
# ============================================================
# 100% local (Python + SQLite + navegador). A única variável que
# exige um serviço externo é LLM_API_KEY (API da Anthropic).

# --- Identidade ---
APP_NAME=Zeus
ENVIRONMENT=development
DEBUG=true

# --- Segurança (GERE UMA CHAVE FORTE E ÚNICA EM PRODUÇÃO) ---
# Ex.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-segura
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# Inclui a porta 5500, usada por "python -m http.server 5500" (veja o README).
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# --- Rate limiting (proteção contra força bruta em login/registro) ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Banco de dados (SQLite puro, sem Docker/PostgreSQL) ---
DATABASE_URL=sqlite:///./data/zeus.db

# --- Documentos (texto extraído fica no próprio SQLite) ---
DOCS_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=15

# --- LLM (cérebro do Zeus) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=sua-chave-de-api-aqui
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6

# --- Idioma ---
DEFAULT_LANGUAGE=pt-BR

# --- Fuso horário (usado pelo plugin de data/hora) ---
TIMEZONE=America/Sao_Paulo

# --- Logs ---
LOG_DIR=./data/logs
LOG_LEVEL=INFO

# --- Plugins ---
PLUGINS_ENABLED=true
